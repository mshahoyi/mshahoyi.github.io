              <div class="date">{n.date}</div>
              <div class="entry" set:html={n.body} />
            </li>
          ))}
        </ol>
      </section>
    </main>
  </body>
</html>

<style>
  /* Always light. No prefers-color-scheme override (that caused the
     load-then-revert flash on dark-mode devices). */
  :global(:root) {
    color-scheme: light;
    --bg: #fdf8f2;
    --bg-2: #f5ece2;
    --fg: #241a17;
    --muted: #8a7165;
    --accent: #8c1414;
    --accent-soft: #b53232;
    --line: #ecdfd3;
  }

  :global(body) {
    margin: 0;
    color: var(--fg);
    background:
      radial-gradient(900px 620px at 12% -8%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%),
      var(--bg);
    background-attachment: fixed;
    font: 17px/1.65 "EB Garamond", Georgia, "Times New Roman", serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  :global(a) { color: inherit; }

  .lander {
    max-width: 1000px;
    margin: 0 auto;
    padding: 72px 28px;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 60px;
    align-items: start;
  }

  /* ---- left column ---- */
  .side { position: sticky; top: 64px; }

  .photo-wrap {
    width: fit-content;
    padding: 5px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--accent-soft), var(--accent));
    box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .photo {
    width: 168px;
    height: 168px;
    border-radius: 15px;
    object-fit: cover;
    display: block;
    border: 3px solid var(--bg);
  }

  .name {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 22px 0 6px;
    color: var(--fg);
  }
  .tagline {
    font-variant: small-caps;
    letter-spacing: 0.12em;
    font-size: 0.92rem;
    color: var(--accent);
    margin: 0 0 18px;
  }
  .tagline::after {
    content: "";
    display: block;
    width: 46px;
    height: 2px;
    margin-top: 12px;
    background: linear-gradient(90deg, var(--accent), transparent);
    border-radius: 2px;
  }
  .bio { margin: 0 0 24px; color: color-mix(in srgb, var(--fg) 88%, transparent); }

  .links { display: flex; flex-direction: column; gap: 9px; }
  .links a {
    text-decoration: none;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    width: fit-content;
    transition: color 0.15s ease;
  }
  .links a::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .links a:hover { color: var(--accent); }
  .links a:hover::before { transform: scale(1.35); }

  /* ---- right column ---- */
  .news-h {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.05rem;
    font-variant: small-caps;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 700;
    margin: 4px 0 22px;
    position: relative;
    padding-bottom: 10px;
  }
  .news-h::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent 75%);
  }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { padding: 0 0 16px 0; }
  .timeline .date {
    color: var(--muted);
    font-style: italic;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .timeline .entry { margin-top: 1px; line-height: 1.55; }
  .timeline .entry :global(em) { color: var(--accent); font-style: italic; }
  .timeline .entry :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .timeline .entry :global(a):hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 720px) {
    .lander { grid-template-columns: 1fr; gap: 38px; padding: 44px 22px; }
    .side { position: static; }
    .name { font-size: 1.85rem; }
  }
</style>
