  }
  .name { font-size: 1.5rem; font-weight: 700; margin: 18px 0 2px; letter-spacing: -0.01em; }
  .tagline { color: var(--muted); margin: 0 0 16px; font-size: 0.95rem; }
  .bio { margin: 0 0 22px; }
  .links { display: flex; flex-direction: column; gap: 8px; }
  .links a {
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: fit-content;
  }
  .links a:hover { color: var(--accent); }
  .links a::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* right */
  .news-h {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
    margin: 6px 0 24px;
  }
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 4px;
    bottom: 8px;
    width: 2px;
    background: var(--line);
  }
  .timeline li { position: relative; padding: 0 0 26px 32px; }
  .timeline li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline .date { color: var(--muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .timeline .entry { margin-top: 2px; line-height: 1.55; }
  .timeline .entry :global(a) { color: var(--accent); text-decoration: none; }
  .timeline .entry :global(a):hover { text-decoration: underline; }

  @media (max-width: 720px) {
    .lander { grid-template-columns: 1fr; gap: 36px; padding: 40px 20px; }
